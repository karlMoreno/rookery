<!--
  examples/drop.xml: the Phase 1 drop scene.

  This is the ONE hand-written MJCF in Rookery (rule 7 says the MJCF is never
  hand-edited). It exists only because the scene generator does not exist yet.
  It is retired in row 2.7, when the drop preset of `scene.py` emits the same scene
  to scene/generated/drop.xml and the Phase 1 gate is pointed there.

  Scene: a ground plane and a 0.1 m cube (half-size 0.05) on a free joint,
  released at z = 0.5. At rest its centre sits at z = 0.05, which is what
  tests/gates/tests/phase1_drop.rs asserts (within 1 mm, after 2 s at 1 ms).

  Bodies: 0 = world (holds the plane), 1 = box. So nbody == 2 (row 1.6 test).
-->
<mujoco model="drop">
  <option timestep="0.001" gravity="0 0 -9.81"/>

  <worldbody>
    <geom name="floor" type="plane" size="1 1 0.1"/>
    <body name="box" pos="0 0 0.5">
      <freejoint name="box_free"/>
      <geom name="box_geom" type="box" size="0.05 0.05 0.05" mass="1"/>
    </body>
  </worldbody>
</mujoco>
